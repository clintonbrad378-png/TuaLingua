      "id": "u9l1",
      "title": "Segunda condicional",
      "goal": "Habla de situaciones hipotéticas y da consejos",
      "tip": [
        "If + pasado simple, would + infinitivo: If I had more time, I would travel.",
        "«If I were you, I would…» es la fórmula para dar consejos.",
        "Describe situaciones poco probables o imaginarias, no reales."
      ],
      "phrases": [
        {
          "es": "Si tuviera más tiempo, viajaría más",
          "t": "If I had more time, I would travel more"
        },
        {
          "es": "Yo de ti hablaría con ella",
          "t": "If I were you, I would talk to her"
        },
        {
          "es": "¿Qué harías si ganaras la lotería?",
          "t": "What would you do if you won the lottery?"
        }
      ],
