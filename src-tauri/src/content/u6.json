    {
      "id": "u6l2",
      "title": "Just, already, yet",
      "goal": "Usa los marcadores del presente perfecto con precisión",
      "tip": [
        "just = acabar de hacer algo: I have just finished.",
        "already = ya (afirmativas); yet = todavía/aún (negativas y preguntas).",
        "been to = ha ido y ha vuelto; gone to = se ha ido (y sigue allí)."
      ],
      "phrases": [
        {
          "es": "Acabo de terminar el informe",
          "t": "I have just finished the report"
        },
        {
          "es": "¿Ya has comido?",
          "t": "Have you eaten yet?"
        },
        {
          "es": "Ana se ha ido a Lisboa (sigue allí)",
          "t": "Ana has gone to Lisbon"
        }
      ],
