    {
      "id": "u6l1",
      "title": "Presente perfecto: ever / never",
      "goal": "Habla de experiencias de vida sin decir cuándo ocurrieron",
      "tip": [
        "have/has + participio: I have been, she has seen.",
        "«Ever» en preguntas (alguna vez) y «never» en negativas (nunca).",
        "Si dices cuándo ocurrió, usa pasado simple: I saw it yesterday."
      ],
      "phrases": [
        {
          "es": "¿Has estado alguna vez en Escocia?",
          "t": "Have you ever been to Scotland?"
        },
        {
          "es": "Nunca he probado el sushi",
          "t": "I have never tried sushi"
        },
        {
          "es": "¿Alguna vez has visto esta película?",
          "t": "Have you ever seen this film?"
        }
      ],
