    {
      "id": "u12l1",
      "title": "So / such, too / enough",
      "goal": "Intensifica como pide el examen (transformaciones)",
      "tip": [
        "so + adjetivo/adverbio; such + (a/an) + sustantivo: so expensive / such an expensive car.",
        "too + adjetivo = demasiado; not … enough = no lo bastante.",
        "enough va antes del sustantivo (enough time) y después del adjetivo (fast enough)."
      ],
      "phrases": [
        {
          "es": "Era tan caro que no lo compramos",
          "t": "It was so expensive that we didn't buy it"
        },
        {
          "es": "Es demasiado pronto para decidir",
          "t": "It's too early to decide"
        },
        {
          "es": "No tengo suficiente tiempo",
          "t": "I don't have enough time"
        }
      ],
