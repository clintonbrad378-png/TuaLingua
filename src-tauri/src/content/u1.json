      "title": "Saludos",
      "goal": "Saluda, despide y di tu nombre",
      "tip": [
        "«Hi» es informal, «Hello» vale en cualquier situación.",
        "Para despedirte: «Bye», «Goodbye» o «See you» (nos vemos)."
      ],
      "phrases": [
        { "es": "¡Hola! ¿Cómo estás?", "t": "Hi! How are you?" },
        { "es": "Bien, gracias. ¿Y tú?", "t": "Good, thanks. And you?" },
        { "es": "Nos vemos mañana", "t": "See you tomorrow" }
      ],
