{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TuaLingua",
  "version": "0.2.0",
  "identifier": "com.tualingua.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TuaLingua",
        "width": 430,
        "height": 860,
        "minWidth": 340,
        "minHeight": 540,
        "resizable": true,
        "backgroundColor": "#100E1B"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:* http://localhost:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}